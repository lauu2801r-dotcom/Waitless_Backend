# Copia este archivo como ".env" y completa los valores. NUNCA subas el .env a GitHub.

# Base de datos (Neon u otra PostgreSQL). Debe terminar en ?sslmode=require si es Neon.
DATABASE_URL=postgresql://USUARIO:CLAVE@HOST/BASE?sslmode=require

# Llave para firmar los tokens (JWT). Genera una larga y aleatoria:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esto-por-una-llave-larga-y-aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Correo para códigos de verificación (Gmail con "contraseña de aplicación")
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=contrasena-de-aplicacion
MAIL_FROM=tu_correo@gmail.com
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587

# Código que debe conocer quien registra un restaurante nuevo
CODIGO_NEGOCIO=cambia-este-codigo

ENVIRONMENT=production
